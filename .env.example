# ── App ────────────────────────────────────────────────────
APP_NAME=AI-Outreach
SECRET_KEY=change-me-to-a-random-64-char-string
DEBUG=true
ALLOWED_ORIGINS=http://localhost:3000

# ── Database ───────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://outreach:outreach_secret@postgres:5432/outreach_db

# ── Redis ──────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ── JWT Auth ───────────────────────────────────────────────
JWT_SECRET_KEY=change-me-jwt-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── OpenAI ─────────────────────────────────────────────────
OPENAI_API_KEY=sk-…

# ── Lead Data APIs (at least one required) ─────────────────
APOLLO_API_KEY=
HUNTER_API_KEY=

# ── Email Service (at least one required) ──────────────────
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=
AWS_SES_REGION=us-east-1
AWS_SES_ACCESS_KEY=
AWS_SES_SECRET_KEY=
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
RESEND_API_KEY=

# ── Email Tracking ─────────────────────────────────────────
TRACKING_DOMAIN=http://localhost:8000
OPEN_PIXEL_SECRET=change-me
